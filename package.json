{
  "name": "deck",
  "version": "0.0.0",
  "private": true,
  "config": {
    "file": "./deck/src/index.md"
  },
  "scripts": {
    "build": "rimraf public && npm run -s deck",
    "deck": "marp --html -I deck/src -o ./public && npm run -s copy-assets && npm run -s build-index",
    "copy-assets": "mkdir -p public/authors/img public/showcase && ncp deck/src/authors/img public/authors/img && ncp deck/src/showcase/showcase.svg public/showcase/showcase.svg",
    "build-index": "node scripts/build-index.mjs",
    "start": "PORT=5001 marp --html -ps deck/src",
    "pdf": "marp --html --pdf"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0",
    "ncp": "^2.0.0",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "@marp-team/marp-core": "^5.0.1",
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.18.4",
    "shiki": "^4.4.3"
  }
}
